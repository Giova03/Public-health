# Base de données (adapter selon l'environnement)
DATABASE_URL=jdbc:postgresql://localhost:5432/publichealth
DATABASE_USER=publichealth
DATABASE_PASSWORD=publichealth

# Port HTTP (Render fournit PORT automatiquement)
PORT=8080

# Secret de signature des webhooks FedaPay — OBLIGATOIRE en production,
# à faire confirmer par FedaPay (format exact des en-têtes : hypothèse E4)
FEDAPAY_WEBHOOK_SECRET=dev-secret-change-me
